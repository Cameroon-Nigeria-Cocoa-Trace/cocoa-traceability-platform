rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Entity Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.keys().hasOnly(['id', 'displayName', 'email', 'role', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 120 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('role' in data) || (data.role in ['farmer', 'buyer', 'cooperative', 'admin'])) &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidFarm(data) {
      return data.keys().hasAll(['id', 'farmerId', 'farmName', 'region', 'geolocation', 'createdAt']) &&
        data.keys().hasOnly(['id', 'farmerId', 'farmerName', 'farmerPhone', 'farmerEmail', 'farmName', 'region', 'village', 'lga', 'state', 'cooperative', 'geolocation', 'sizeHectares', 'registrationDate', 'cocoaVariety', 'harvestSeason', 'estimatedAnnualYieldKg', 'quantityHarvestedKg', 'batchNumber', 'aggregatorCenter', 'batchMovementRoute', 'processorExporter', 'designatedBuyer', 'landDocType', 'landDocReference', 'deforestationRisk', 'auditStatus', 'auditCertificateNumber', 'auditorName', 'auditDate', 'paymentMethod', 'transactionReference', 'transactionAmount', 'eudrCompliant', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.farmerId is string && data.farmerId.size() <= 128 &&
        data.farmName is string && data.farmName.size() > 0 && data.farmName.size() <= 120 &&
        data.region is string && data.region.size() > 0 && data.region.size() <= 100 &&
        data.geolocation is string && data.geolocation.size() > 0 && data.geolocation.size() <= 60 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('farmerName' in data) || (data.farmerName is string && data.farmerName.size() <= 100)) &&
        (!('farmerPhone' in data) || (data.farmerPhone is string && data.farmerPhone.size() <= 40)) &&
        (!('farmerEmail' in data) || (data.farmerEmail is string && data.farmerEmail.size() <= 120)) &&
        (!('village' in data) || (data.village is string && data.village.size() <= 100)) &&
        (!('lga' in data) || (data.lga is string && data.lga.size() <= 100)) &&
        (!('state' in data) || (data.state is string && data.state.size() <= 100)) &&
        (!('cooperative' in data) || (data.cooperative is string && data.cooperative.size() <= 120)) &&
        (!('sizeHectares' in data) || (data.sizeHectares is number)) &&
        (!('registrationDate' in data) || (data.registrationDate is string && data.registrationDate.size() <= 40)) &&
        (!('cocoaVariety' in data) || (data.cocoaVariety is string && data.cocoaVariety.size() <= 80)) &&
        (!('harvestSeason' in data) || (data.harvestSeason is string && data.harvestSeason.size() <= 60)) &&
        (!('estimatedAnnualYieldKg' in data) || (data.estimatedAnnualYieldKg is number)) &&
        (!('quantityHarvestedKg' in data) || (data.quantityHarvestedKg is number)) &&
        (!('batchNumber' in data) || (data.batchNumber is string && data.batchNumber.size() <= 64)) &&
        (!('aggregatorCenter' in data) || (data.aggregatorCenter is string && data.aggregatorCenter.size() <= 120)) &&
        (!('batchMovementRoute' in data) || (data.batchMovementRoute is string && data.batchMovementRoute.size() <= 200)) &&
        (!('processorExporter' in data) || (data.processorExporter is string && data.processorExporter.size() <= 120)) &&
        (!('designatedBuyer' in data) || (data.designatedBuyer is string && data.designatedBuyer.size() <= 120)) &&
        (!('landDocType' in data) || (data.landDocType is string && data.landDocType.size() <= 100)) &&
        (!('landDocReference' in data) || (data.landDocReference is string && data.landDocReference.size() <= 100)) &&
        (!('deforestationRisk' in data) || (data.deforestationRisk is string && data.deforestationRisk.size() <= 100)) &&
        (!('auditStatus' in data) || (data.auditStatus is string && data.auditStatus.size() <= 60)) &&
        (!('auditCertificateNumber' in data) || (data.auditCertificateNumber is string && data.auditCertificateNumber.size() <= 100)) &&
        (!('auditorName' in data) || (data.auditorName is string && data.auditorName.size() <= 100)) &&
        (!('auditDate' in data) || (data.auditDate is string && data.auditDate.size() <= 40)) &&
        (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 80)) &&
        (!('transactionReference' in data) || (data.transactionReference is string && data.transactionReference.size() <= 100)) &&
        (!('transactionAmount' in data) || (data.transactionAmount is string && data.transactionAmount.size() <= 60)) &&
        (!('eudrCompliant' in data) || (data.eudrCompliant is bool));
    }

    function isValidProductLot(data) {
      return data.keys().hasAll(['id', 'title', 'seller', 'origin', 'quantity', 'price', 'compliance', 'status', 'trace', 'route']) &&
        data.keys().hasOnly(['id', 'title', 'seller', 'sellerId', 'origin', 'geolocation', 'quantity', 'price', 'compliance', 'status', 'trace', 'route', 'description', 'createdAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.seller is string && data.seller.size() > 0 && data.seller.size() <= 100 &&
        (!('sellerId' in data) || (data.sellerId is string && data.sellerId.size() <= 128)) &&
        data.origin is string && data.origin.size() > 0 && data.origin.size() <= 120 &&
        (!('geolocation' in data) || (data.geolocation is string && data.geolocation.size() <= 60)) &&
        data.quantity is string && data.quantity.size() <= 50 &&
        data.price is string && data.price.size() <= 50 &&
        data.compliance is string && data.compliance.size() <= 60 &&
        data.status in ['Available', 'Reserved', 'Sold', 'In-Transit'] &&
        data.trace is string && data.trace.size() <= 64 &&
        data.route is string && data.route.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40));
    }

    function isValidTraceEvent(data) {
      return data.keys().hasAll(['id', 'lotId', 'step', 'detail', 'date']) &&
        data.keys().hasOnly(['id', 'lotId', 'step', 'detail', 'date', 'verified']) &&
        data.id is string && data.id.size() <= 64 &&
        data.lotId is string && data.lotId.size() <= 64 &&
        data.step is string && data.step.size() > 0 && data.step.size() <= 100 &&
        data.detail is string && data.detail.size() > 0 && data.detail.size() <= 500 &&
        data.date is string && data.date.size() > 0 && data.date.size() <= 50 &&
        (!('verified' in data) || (data.verified is bool));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && (!('role' in incoming()) || incoming().role != 'admin');
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUser(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName']) &&
        incoming().id == existing().id &&
        incoming().email == existing().email;
      allow delete: if isAdmin();
    }

    // Farms Collection
    match /farms/{farmId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(farmId) && isValidFarm(incoming()) && incoming().farmerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(farmId) && (existing().farmerId == request.auth.uid || isAdmin()) &&
        isValidFarm(incoming()) &&
        incoming().farmerId == existing().farmerId &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['farmerName', 'farmerPhone', 'farmerEmail', 'farmName', 'region', 'village', 'lga', 'state', 'cooperative', 'geolocation', 'sizeHectares', 'registrationDate', 'cocoaVariety', 'harvestSeason', 'estimatedAnnualYieldKg', 'quantityHarvestedKg', 'batchNumber', 'aggregatorCenter', 'batchMovementRoute', 'processorExporter', 'designatedBuyer', 'landDocType', 'landDocReference', 'deforestationRisk', 'auditStatus', 'auditCertificateNumber', 'auditorName', 'auditDate', 'paymentMethod', 'transactionReference', 'transactionAmount', 'eudrCompliant']);
      allow delete: if isSignedIn() && isValidId(farmId) && (existing().farmerId == request.auth.uid || isAdmin());
    }

    // Marketplace / Traceable Cocoa Lots
    match /lots/{lotId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(lotId) && isValidProductLot(incoming()) && (incoming().sellerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(lotId) && isValidProductLot(incoming()) &&
        (existing().sellerId == request.auth.uid || isAdmin()) &&
        incoming().sellerId == existing().sellerId &&
        incoming().id == existing().id &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'price', 'status', 'description', 'route', 'compliance', 'quantity']);
      allow delete: if isSignedIn() && isValidId(lotId) && (existing().sellerId == request.auth.uid || isAdmin());

      // Sub-collection: Chain of Custody Trace Events
      match /events/{eventId} {
        allow get, list: if true;
        allow create: if isSignedIn() && isValidId(eventId) && isValidTraceEvent(incoming()) &&
          incoming().lotId == lotId &&
          (get(/databases/$(database)/documents/lots/$(lotId)).data.sellerId == request.auth.uid || isAdmin());
        allow update, delete: if isAdmin();
      }
    }
  }
}
