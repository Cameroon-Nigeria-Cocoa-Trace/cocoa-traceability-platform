rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || (request.auth.token.email != null && request.auth.token.email == "afumbomboyo@gmail.com")
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // USER PROFILES
    match /users/{userId} {
      // Allow reading user profiles for trade counterparties, cooperatives, and audit verification
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // FARMS & GEOFENCED PLOTS
    // Farm boundaries and EUDR polygon data are auditable and verifiable
    match /farms/{farmId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    // LEGACY LOTS AND EVENTS
    match /lots/{lotId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin() || true;

      match /events/{eventId} {
        allow read: if true;
        allow write: if isSignedIn() || isAdmin() || true;
      }
    }

    // MARKETPLACE LISTINGS
    // Public buyers can browse catalog; authenticated sellers can list and update lots
    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    // PRODUCTION RECORDS (PRODUCTIONS)
    match /productions/{prodId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /productionRecords/{prodId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    // HARVESTS
    match /harvests/{harvestId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    // COCOA LOTS
    // Traceable lot details are viewable for marketplace and origin inspection
    match /cocoaLots/{lotId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    // CERTIFICATES & APPLICATION RECORDS
    // Origin trace certificates are publicly verifiable for EUDR and export due diligence
    match /certificates/{certId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin() || true;
      allow delete: if isAdmin();
    }

    match /certificateApplications/{appId} {
      allow read, write: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    // COCOA TRANSFER SUB-SECTION: HOLDINGS & TRANSFERS
    // Certificate holdings represent physical custody units; publicly auditable for EUDR
    match /certificateHoldings/{holdingId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin() || true;
      allow delete: if isAdmin();
    }

    // Certificate transfers represent atomic custody handoffs across verified routes
    match /certificateTransfers/{transferId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin() || true;
      allow delete: if isAdmin();
    }

    // COOPERATIVE HUB & FARMER ASSOCIATIONS
    match /farmerCooperativeAssociations/{assocId} {
      allow read, write: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /cooperative_organizations/{orgId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /cooperative_profiles/{profileId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /cooperative_memberships/{membershipId} {
      allow read, write: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /cooperatives/{coopId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /cooperative_membership_history/{historyId} {
      allow read, write: if isSignedIn() || true;
    }

    match /cooperative_subordinates/{subId} {
      allow read, write: if isSignedIn() || true;
    }

    // QR CODES & TRACEABILITY VERIFICATION
    match /qrCodes/{qrId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    match /qrScans/{scanId} {
      allow create: if true;
      allow read: if isSignedIn();
    }

    match /lotCounters/{lotId} {
      allow read, write: if isSignedIn();
    }

    // TRADE MANAGEMENT SUB-SECTION: TRADES, PAYMENTS, SELLER ACCESS & REVIEWS
    match /trades/{tradeId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if false;
    }

    match /sellerAccessRecords/{recordId} {
      allow read, write: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /marketplaceReviews/{reviewId} {
      allow read: if true;
      allow read, write, create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    match /cocoaLotAdjustments/{adjId} {
      allow read, write: if isSignedIn() || true;
      allow delete: if isAdmin();
    }

    // SUPPLY CHAIN ROUTE PARTICIPANTS (AGENTS, WAREHOUSES, CUSTOMS)
    match /agents/{agentId} {
      allow read, write: if isSignedIn() || true;
    }

    match /agent_profiles/{agentId} {
      allow read, write: if isSignedIn() || true;
    }

    match /agent_organizations/{agentId} {
      allow read, write: if isSignedIn() || true;
    }

    match /agent_linkages/{linkId} {
      allow read, write: if isSignedIn() || true;
    }

    match /agent_operations/{opId} {
      allow read, write: if isSignedIn() || true;
    }

    match /warehouses/{warehouseId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    match /warehouse_facilities/{warehouseId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    match /warehouse_organizations/{warehouseId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    match /warehouse_receipts/{receiptId} {
      allow read, write: if isSignedIn() || true;
    }

    match /warehouse_crs_requests/{requestId} {
      allow read, write: if isSignedIn() || true;
    }

    match /customs_requests/{reqId} {
      allow read, write: if isSignedIn() || true;
    }

    match /customs_profiles/{profileId} {
      allow read, write: if isSignedIn() || true;
    }

    match /customs_agencies/{agencyId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    match /customs_processing_history/{historyId} {
      allow read, write: if isSignedIn() || true;
    }

    // SYSTEM ADMIN CONFIGS & AUDIT LOGS
    match /admin_settings/{settingId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }

    match /admin_fee_configs/{configId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }

    match /admin_entity_statuses/{statusId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || true;
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isSignedIn() || true;
    }

    // DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}