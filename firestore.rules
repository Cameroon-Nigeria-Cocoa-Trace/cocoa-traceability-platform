rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || (request.auth.token.email != null && request.auth.token.email == "afumbomboyo@gmail.com")
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // USER PROFILES
    match /users/{userId} {
      // Users can read their own profile.
      // Administrators require a trusted Firebase custom claim.
      allow get: if isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      // Listing all profiles is restricted to administrators.
      allow list: if isAdmin();

      // New profiles may only be created by their owner
      // with the ordinary farmer role.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.role == "farmer"
        && request.resource.data.keys().hasOnly([
          "id",
          "displayName",
          "email",
          "role",
          "createdAt"
        ]);

      // A user may update their display name, but cannot
      // modify their UID, role, or account creation timestamp.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["displayName"])
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;

      // Profile deletion must go through a trusted server workflow.
      allow delete: if false;
    }

    match /admins/{adminId} {
      // A user may check their own admin record.
      // Only administrators may list admin records.
      allow get: if isSignedIn()
        && (
          request.auth.uid == adminId
          || isAdmin()
        );

      allow list: if isAdmin();

      // Administrator records must be managed by trusted server code.
      allow create, update, delete: if false;
    }
    
    match /farms/{farmId} {
      // Farmers can read only their own farms.
      // Administrator access requires a trusted custom claim.
      allow read: if isSignedIn()
        && (
          resource.data.farmerId == request.auth.uid
          || isAdmin()
        );

      // All farm creation, updates and deletion must use
      // authenticated server API routes with validation.
      allow create, update, delete: if false;
    }

    // LEGACY LOTS AND EVENTS
    // Direct client access is disabled until each required
    // read/write workflow has been explicitly authorized.
    match /lots/{lotId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // MARKETPLACE LISTINGS
    // Public buyers and visitors can browse published listings.
    // Sellers can create and update listings.
    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // PRODUCTION RECORDS (PRODUCTIONS)
    // Seasonal cocoa production targets, periods, and harvest campaign yield metrics.
    match /productions/{prodId} {
      // Production records can be viewed by authenticated users (farmers, buyers, cooperatives, certifiers)
      allow read: if isSignedIn();

      // Create: Authenticated farmer creates seasonal campaign for their farm
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.productionRecordId is string
        && request.resource.data.farmId is string
        && request.resource.data.seasonYear is string
        && request.resource.data.startDate is string;

      // Update: Creator or admin can update, or harvest transaction updating cumulative actualQuantityKg/numberOfHarvests
      // Immutable fields (productionRecordId, farmId, createdBy, createdAt) are strictly preserved
      allow update: if isSignedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || isAdmin()
          || (
            request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.farmId == resource.data.farmId
            && request.resource.data.productionRecordId == resource.data.productionRecordId
            && request.resource.data.createdAt == resource.data.createdAt
          )
        )
        && request.resource.data.productionRecordId == resource.data.productionRecordId
        && request.resource.data.farmId == resource.data.farmId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      // Historical production records must be preserved for immutable lineage
      allow delete: if isAdmin();
    }

    match /productionRecords/{prodId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.productionRecordId is string
        && request.resource.data.farmId is string;

      allow update: if isSignedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || isAdmin()
          || (
            request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.farmId == resource.data.farmId
            && request.resource.data.productionRecordId == resource.data.productionRecordId
            && request.resource.data.createdAt == resource.data.createdAt
          )
        )
        && request.resource.data.productionRecordId == resource.data.productionRecordId
        && request.resource.data.farmId == resource.data.farmId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();
    }

    // HARVESTS
    // Logged harvest batches linked to farm and production records
    match /harvests/{harvestId} {
      // Authenticated users (farmers managing inventory, certifiers auditing yields) can read harvests
      allow read: if isSignedIn();

      // Create: Farmer creates harvest linked to their farm and production record
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.harvestId is string
        && request.resource.data.productionRecordId is string
        && request.resource.data.farmId is string
        && request.resource.data.quantityKg is number
        && request.resource.data.quantityKg > 0;

      // Update: Creator or admin can update, or cocoa lot allocation updating allocatedQuantityKg
      // Immutable fields must remain unchanged
      allow update: if isSignedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || isAdmin()
          || (
            request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.farmId == resource.data.farmId
            && request.resource.data.productionRecordId == resource.data.productionRecordId
            && request.resource.data.harvestId == resource.data.harvestId
            && request.resource.data.quantityKg == resource.data.quantityKg
            && request.resource.data.createdAt == resource.data.createdAt
          )
        )
        && request.resource.data.harvestId == resource.data.harvestId
        && request.resource.data.farmId == resource.data.farmId
        && request.resource.data.productionRecordId == resource.data.productionRecordId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      // Historical harvest events are preserved for immutable traceability
      allow delete: if isAdmin();
    }

    // COCOA LOTS
    // Traceable lot details are viewable for marketplace and origin inspection.
    match /cocoaLots/{lotId} {
      // Public read for marketplace buyers, export due diligence, and QR code verification
      allow read: if true;

      // Create: Authenticated farmer or aggregator registers cocoa lot
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lotId is string
        && request.resource.data.farmId is string
        && request.resource.data.productionRecordId is string
        && request.resource.data.harvestId is string
        && request.resource.data.quantityKg is number
        && request.resource.data.quantityKg > 0;

      // Update: Creator or admin, or marketplace trade & certificate transitions
      // Immutable upstream lineage must remain unchanged
      allow update: if isSignedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || isAdmin()
          || (
            request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.farmId == resource.data.farmId
            && request.resource.data.productionRecordId == resource.data.productionRecordId
            && request.resource.data.harvestId == resource.data.harvestId
            && request.resource.data.lotId == resource.data.lotId
            && request.resource.data.createdAt == resource.data.createdAt
          )
        )
        && request.resource.data.lotId == resource.data.lotId
        && request.resource.data.farmId == resource.data.farmId
        && request.resource.data.productionRecordId == resource.data.productionRecordId
        && request.resource.data.harvestId == resource.data.harvestId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      // Deletion restricted to administrators
      allow delete: if isAdmin();
    }

    // CERTIFICATES & HOLDINGS
    // Origin trace certificates are publicly verifiable for EUDR and export due-diligence.
    match /certificates/{certId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /certificateHoldings/{holdingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /certificateApplications/{appId} {
      allow read, write: if isSignedIn();
    }

    match /certificateTransfers/{transferId} {
      allow read, write: if isSignedIn();
    }

    // QR CODES & TRACEABILITY VERIFICATION
    match /qrCodes/{qrId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    match /qrScans/{scanId} {
      allow create: if true;
      allow read: if isSignedIn();
    }

    match /lotCounters/{lotId} {
      allow read, write: if isSignedIn();
    }

    // TRADES, PAYMENTS & SELLER ACCESS
    match /trades/{tradeId} {
      allow read: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid
        || resource.data.buyerId == request.auth.uid
        || resource.data.sellerUid == request.auth.uid
        || resource.data.sellerId == request.auth.uid
        || resource.data.sellerHolderId == request.auth.uid
        || isAdmin()
      );
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid
        || resource.data.buyerId == request.auth.uid
        || resource.data.sellerUid == request.auth.uid
        || resource.data.sellerId == request.auth.uid
        || isAdmin()
      );
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /sellerAccessRecords/{recordId} {
      allow read: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid
        || resource.data.buyerId == request.auth.uid
        || resource.data.sellerUid == request.auth.uid
        || resource.data.sellerId == request.auth.uid
        || resource.data.sellerHolderId == request.auth.uid
        || isAdmin()
      );
      allow write: if isSignedIn();
    }

    match /cocoaLotAdjustments/{adjId} {
      allow read, write: if isSignedIn();
    }

    // DEFAULT DENY
    // Collections must receive explicit, reviewed permissions.
    // Do not grant broad access to unreviewed collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}