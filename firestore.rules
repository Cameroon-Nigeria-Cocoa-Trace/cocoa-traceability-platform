rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }

    // USER PROFILES
    match /users/{userId} {
      // Users can read their own profile.
      // Administrators require a trusted Firebase custom claim.
      allow get: if isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      // Listing all profiles is restricted to administrators.
      allow list: if isAdmin();

      // New profiles may only be created by their owner
      // with the ordinary farmer role.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.role == "farmer"
        && request.resource.data.keys().hasOnly([
          "id",
          "displayName",
          "email",
          "role",
          "createdAt"
        ]);

      // A user may update their display name, but cannot
      // modify their UID, role, or account creation timestamp.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["displayName"])
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;

      // Profile deletion must go through a trusted server workflow.
      allow delete: if false;
    }

    match /admins/{adminId} {
      // A user may check their own admin record.
      // Only administrators may list admin records.
      allow get: if isSignedIn()
        && (
          request.auth.uid == adminId
          || isAdmin()
        );

      allow list: if isAdmin();

      // Administrator records must be managed by trusted server code.
      allow create, update, delete: if false;
    }
    
    match /farms/{farmId} {
      // Farmers can read only their own farms.
      // Administrator access requires a trusted custom claim.
      allow read: if isSignedIn()
        && (
          resource.data.farmerId == request.auth.uid
          || isAdmin()
        );

      // All farm creation, updates and deletion must use
      // authenticated server API routes with validation.
      allow create, update, delete: if false;
    }

    // LEGACY LOTS AND EVENTS
    // Direct client access is disabled until each required
    // read/write workflow has been explicitly authorized.
    match /lots/{lotId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // MARKETPLACE LISTINGS
    // Public buyers and visitors can browse published listings.
    // Sellers can create and update listings.
    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // COCOA LOTS
    // Traceable lot details are viewable for marketplace and origin inspection.
    match /cocoaLots/{lotId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // CERTIFICATES & HOLDINGS
    // Origin trace certificates are publicly verifiable for EUDR and export due-diligence.
    match /certificates/{certId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /certificateHoldings/{holdingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /certificateApplications/{appId} {
      allow read, write: if isSignedIn();
    }

    match /certificateTransfers/{transferId} {
      allow read, write: if isSignedIn();
    }

    // QR CODES & TRACEABILITY VERIFICATION
    match /qrCodes/{qrId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    match /qrScans/{scanId} {
      allow create: if true;
      allow read: if isSignedIn();
    }

    match /lotCounters/{lotId} {
      allow read, write: if isSignedIn();
    }

    // TRADES, PAYMENTS & SELLER ACCESS
    match /trades/{tradeId} {
      allow read: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid
        || resource.data.sellerUid == request.auth.uid
        || isAdmin()
      );
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid
        || resource.data.sellerUid == request.auth.uid
        || isAdmin()
      );
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /sellerAccessRecords/{recordId} {
      allow read: if isSignedIn() && (
        resource.data.buyerUid == request.auth.uid
        || resource.data.sellerUid == request.auth.uid
        || isAdmin()
      );
      allow write: if isSignedIn();
    }

    match /cocoaLotAdjustments/{adjId} {
      allow read, write: if isSignedIn();
    }

    // DEFAULT DENY
    // Collections must receive explicit, reviewed permissions.
    // Do not grant broad access to unreviewed collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}